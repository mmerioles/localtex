{
  // Builds use LaTeX Workshop's built-in "latexmk" recipe. setup.sh / setup.cmd
  // put LaTeX on your PATH so it works the same on Mac and Windows.
  "latex-workshop.latex.autoBuild.run": "onSave",

  // Overleaf-style: save automatically a moment after you stop typing,
  // which triggers a rebuild, and show the PDF in a tab to the right.
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.linting.chktex.enabled": false,
  "[latex]": { "editor.wordWrap": "on" }
}
